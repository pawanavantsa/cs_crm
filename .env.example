# --- Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Behind Cloud Run / a TLS proxy:
TRUST_X_FORWARDED_PROTO=False
POSTGRES_PASSWORD=changeme

# Seed "Glow & Co. Studio" on first start and create admin / DEMO_PASSWORD
SEED_DEMO=true
DEMO_PASSWORD=xeroura-demo
# Lets "New → Simulate customer message" run fake messages through the webhook pipeline
ENABLE_SIMULATOR=True

# --- WhatsApp Cloud API (fallback — you can also paste these in Settings → WhatsApp)
WHATSAPP_API_VERSION=v22.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=my-verify-token
# App secret → verifies X-Hub-Signature-256 on every webhook (recommended in production)
WHATSAPP_APP_SECRET=

# --- AI replies (optional — without a key, suggestions come from your quick replies)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# --- ngrok (optional, for webhooks in development)
NGROK_AUTHTOKEN=
